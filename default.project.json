{
  "name": "roblox-game",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "emitLegacyScripts": true,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "GameServer": {
        "$className": "Folder",
        "$path": "src/server",
        "$ignoreUnknownInstances": true
      }
    },
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "GameShared": {
        "$className": "Folder",
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "GameClient": {
          "$className": "Folder",
          "$path": "src/client",
          "$ignoreUnknownInstances": true
        }
      }
    }
  }
}
