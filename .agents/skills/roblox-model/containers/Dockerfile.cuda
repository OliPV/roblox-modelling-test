# NVIDIA PyTorch CUDA container for Windows (WSL2 Docker Desktop)
# Base image includes Python 3.10+, PyTorch 2.4+, CUDA 12.x, cuDNN, and ninja for custom rasterizer compilation
FROM nvcr.io/nvidia/pytorch:24.08-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV MODEL_TOOLS_DIR=/opt/models
ENV MODEL_WORKSPACE=/workspace
ENV HF_HOME=/root/.cache/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip wheel setuptools && \
    pip install --no-cache-dir \
    fastapi "uvicorn[standard]" pydantic requests \
    "rembg[gpu]" onnxruntime-gpu pillow trimesh scipy \
    huggingface_hub transformers diffusers accelerate einops omegaconf

WORKDIR /opt/models

# Clone Hunyuan3D-2 & TripoSR
RUN git clone --depth 1 https://github.com/Tencent/Hunyuan3D-2.git /opt/models/Hunyuan3D-2 && \
    pip install --no-cache-dir -e /opt/models/Hunyuan3D-2

RUN git clone --depth 1 https://github.com/VAST-AI-Research/TripoSR.git /opt/models/TripoSR && \
    pip install --no-cache-dir -r /opt/models/TripoSR/requirements.txt

COPY server.py /opt/models/server.py

EXPOSE 8085
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8085"]
